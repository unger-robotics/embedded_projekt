# Selection Panel Prototyp (10×) - KiCad Netzliste
# Format: KiCad Legacy Netlist
# Version: 2.2.5
# Datum: Dezember 2025

(export (version D)
  (design
    (source "selection-panel-prototyp.kicad_sch")
    (date "2025-12-27")
    (tool "Claude AI")
  )
  (components
    # ==================== Mikrocontroller ====================
    (comp (ref U1)
      (value "ESP32-S3-XIAO")
      (footprint "Seeed:XIAO-ESP32S3")
      (datasheet "https://wiki.seeedstudio.com/xiao_esp32s3_getting_started/")
    )
    
    # ==================== Output Shift Registers (LEDs) ====================
    (comp (ref U2)
      (value "74HC595")
      (footprint "Package_DIP:DIP-16_W7.62mm")
      (datasheet "https://www.ti.com/lit/ds/symlink/sn74hc595.pdf")
      (fields
        (field (name "Description") "LED Output Register #0 (LED 0-7)")
      )
    )
    (comp (ref U3)
      (value "74HC595")
      (footprint "Package_DIP:DIP-16_W7.62mm")
      (datasheet "https://www.ti.com/lit/ds/symlink/sn74hc595.pdf")
      (fields
        (field (name "Description") "LED Output Register #1 (LED 8-9)")
      )
    )
    
    # ==================== Input Shift Registers (Buttons) ====================
    (comp (ref U4)
      (value "CD4021BE")
      (footprint "Package_DIP:DIP-16_W7.62mm")
      (datasheet "https://www.ti.com/lit/ds/symlink/cd4021b.pdf")
      (fields
        (field (name "Description") "Button Input Register #0 (BTN 0-7)")
      )
    )
    (comp (ref U5)
      (value "CD4021BE")
      (footprint "Package_DIP:DIP-16_W7.62mm")
      (datasheet "https://www.ti.com/lit/ds/symlink/cd4021b.pdf")
      (fields
        (field (name "Description") "Button Input Register #1 (BTN 8-9)")
      )
    )
    
    # ==================== LEDs ====================
    (comp (ref D1) (value "LED_5mm") (footprint "LED_THT:LED_D5.0mm"))
    (comp (ref D2) (value "LED_5mm") (footprint "LED_THT:LED_D5.0mm"))
    (comp (ref D3) (value "LED_5mm") (footprint "LED_THT:LED_D5.0mm"))
    (comp (ref D4) (value "LED_5mm") (footprint "LED_THT:LED_D5.0mm"))
    (comp (ref D5) (value "LED_5mm") (footprint "LED_THT:LED_D5.0mm"))
    (comp (ref D6) (value "LED_5mm") (footprint "LED_THT:LED_D5.0mm"))
    (comp (ref D7) (value "LED_5mm") (footprint "LED_THT:LED_D5.0mm"))
    (comp (ref D8) (value "LED_5mm") (footprint "LED_THT:LED_D5.0mm"))
    (comp (ref D9) (value "LED_5mm") (footprint "LED_THT:LED_D5.0mm"))
    (comp (ref D10) (value "LED_5mm") (footprint "LED_THT:LED_D5.0mm"))
    
    # ==================== LED Vorwiderstände (330Ω) ====================
    (comp (ref R1) (value "330R") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P7.62mm_Horizontal"))
    (comp (ref R2) (value "330R") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P7.62mm_Horizontal"))
    (comp (ref R3) (value "330R") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P7.62mm_Horizontal"))
    (comp (ref R4) (value "330R") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P7.62mm_Horizontal"))
    (comp (ref R5) (value "330R") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P7.62mm_Horizontal"))
    (comp (ref R6) (value "330R") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P7.62mm_Horizontal"))
    (comp (ref R7) (value "330R") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P7.62mm_Horizontal"))
    (comp (ref R8) (value "330R") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P7.62mm_Horizontal"))
    (comp (ref R9) (value "330R") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P7.62mm_Horizontal"))
    (comp (ref R10) (value "330R") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P7.62mm_Horizontal"))
    
    # ==================== Taster ====================
    (comp (ref SW1) (value "SW_Push_6x6mm") (footprint "Button_Switch_THT:SW_PUSH_6mm"))
    (comp (ref SW2) (value "SW_Push_6x6mm") (footprint "Button_Switch_THT:SW_PUSH_6mm"))
    (comp (ref SW3) (value "SW_Push_6x6mm") (footprint "Button_Switch_THT:SW_PUSH_6mm"))
    (comp (ref SW4) (value "SW_Push_6x6mm") (footprint "Button_Switch_THT:SW_PUSH_6mm"))
    (comp (ref SW5) (value "SW_Push_6x6mm") (footprint "Button_Switch_THT:SW_PUSH_6mm"))
    (comp (ref SW6) (value "SW_Push_6x6mm") (footprint "Button_Switch_THT:SW_PUSH_6mm"))
    (comp (ref SW7) (value "SW_Push_6x6mm") (footprint "Button_Switch_THT:SW_PUSH_6mm"))
    (comp (ref SW8) (value "SW_Push_6x6mm") (footprint "Button_Switch_THT:SW_PUSH_6mm"))
    (comp (ref SW9) (value "SW_Push_6x6mm") (footprint "Button_Switch_THT:SW_PUSH_6mm"))
    (comp (ref SW10) (value "SW_Push_6x6mm") (footprint "Button_Switch_THT:SW_PUSH_6mm"))
    
    # ==================== Pull-Up Widerstände (10kΩ) ====================
    (comp (ref R11) (value "10K") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P7.62mm_Horizontal"))
    (comp (ref R12) (value "10K") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P7.62mm_Horizontal"))
    (comp (ref R13) (value "10K") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P7.62mm_Horizontal"))
    (comp (ref R14) (value "10K") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P7.62mm_Horizontal"))
    (comp (ref R15) (value "10K") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P7.62mm_Horizontal"))
    (comp (ref R16) (value "10K") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P7.62mm_Horizontal"))
    (comp (ref R17) (value "10K") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P7.62mm_Horizontal"))
    (comp (ref R18) (value "10K") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P7.62mm_Horizontal"))
    (comp (ref R19) (value "10K") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P7.62mm_Horizontal"))
    (comp (ref R20) (value "10K") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P7.62mm_Horizontal"))
    
    # ==================== Abblockkondensatoren (100nF) ====================
    (comp (ref C1) (value "100nF") (footprint "Capacitor_THT:C_Disc_D5.0mm_W2.5mm_P2.50mm")
      (fields (field (name "Description") "Bypass für U2 (74HC595 #0)"))
    )
    (comp (ref C2) (value "100nF") (footprint "Capacitor_THT:C_Disc_D5.0mm_W2.5mm_P2.50mm")
      (fields (field (name "Description") "Bypass für U3 (74HC595 #1)"))
    )
    (comp (ref C3) (value "100nF") (footprint "Capacitor_THT:C_Disc_D5.0mm_W2.5mm_P2.50mm")
      (fields (field (name "Description") "Bypass für U4 (CD4021 #0)"))
    )
    (comp (ref C4) (value "100nF") (footprint "Capacitor_THT:C_Disc_D5.0mm_W2.5mm_P2.50mm")
      (fields (field (name "Description") "Bypass für U5 (CD4021 #1)"))
    )
  )
  
  (nets
    # ==================== Power Rails ====================
    (net (code 1) (name "VCC")
      (node (ref U1) (pin 3V3))
      (node (ref U2) (pin 16))
      (node (ref U2) (pin 10))  # SRCLR → VCC
      (node (ref U3) (pin 16))
      (node (ref U3) (pin 10))  # SRCLR → VCC
      (node (ref U4) (pin 16))
      (node (ref U5) (pin 16))
      (node (ref U5) (pin 11))  # SER am letzten CD4021 → VCC (WICHTIG!)
      (node (ref C1) (pin 1))
      (node (ref C2) (pin 1))
      (node (ref C3) (pin 1))
      (node (ref C4) (pin 1))
      (node (ref R11) (pin 1))  # Pull-Up BTN0
      (node (ref R12) (pin 1))  # Pull-Up BTN1
      (node (ref R13) (pin 1))  # Pull-Up BTN2
      (node (ref R14) (pin 1))  # Pull-Up BTN3
      (node (ref R15) (pin 1))  # Pull-Up BTN4
      (node (ref R16) (pin 1))  # Pull-Up BTN5
      (node (ref R17) (pin 1))  # Pull-Up BTN6
      (node (ref R18) (pin 1))  # Pull-Up BTN7
      (node (ref R19) (pin 1))  # Pull-Up BTN8
      (node (ref R20) (pin 1))  # Pull-Up BTN9
    )
    
    (net (code 2) (name "GND")
      (node (ref U1) (pin GND))
      (node (ref U2) (pin 8))
      (node (ref U2) (pin 13))  # OE → GND
      (node (ref U3) (pin 8))
      (node (ref U3) (pin 13))  # OE → GND
      (node (ref U4) (pin 8))
      (node (ref U5) (pin 8))
      (node (ref C1) (pin 2))
      (node (ref C2) (pin 2))
      (node (ref C3) (pin 2))
      (node (ref C4) (pin 2))
      (node (ref D1) (pin K))
      (node (ref D2) (pin K))
      (node (ref D3) (pin K))
      (node (ref D4) (pin K))
      (node (ref D5) (pin K))
      (node (ref D6) (pin K))
      (node (ref D7) (pin K))
      (node (ref D8) (pin K))
      (node (ref D9) (pin K))
      (node (ref D10) (pin K))
      (node (ref SW1) (pin 2))
      (node (ref SW2) (pin 2))
      (node (ref SW3) (pin 2))
      (node (ref SW4) (pin 2))
      (node (ref SW5) (pin 2))
      (node (ref SW6) (pin 2))
      (node (ref SW7) (pin 2))
      (node (ref SW8) (pin 2))
      (node (ref SW9) (pin 2))
      (node (ref SW10) (pin 2))
    )
    
    # ==================== ESP32 → 74HC595 (LED Output) ====================
    (net (code 3) (name "LED_DATA")
      (node (ref U1) (pin D0))
      (node (ref U2) (pin 14))  # SER
    )
    
    (net (code 4) (name "LED_CLOCK")
      (node (ref U1) (pin D1))
      (node (ref U2) (pin 11))  # SRCLK
      (node (ref U3) (pin 11))  # SRCLK (Bus)
    )
    
    (net (code 5) (name "LED_LATCH")
      (node (ref U1) (pin D2))
      (node (ref U2) (pin 12))  # RCLK
      (node (ref U3) (pin 12))  # RCLK (Bus)
    )
    
    # ==================== 74HC595 Cascade ====================
    (net (code 6) (name "LED_CASCADE")
      (node (ref U2) (pin 9))   # QH' von #0
      (node (ref U3) (pin 14))  # SER von #1
    )
    
    # ==================== ESP32 ← CD4021 (Button Input) ====================
    (net (code 7) (name "BTN_DATA")
      (node (ref U1) (pin D3))
      (node (ref U4) (pin 3))   # Q8
    )
    
    (net (code 8) (name "BTN_CLOCK")
      (node (ref U1) (pin D4))
      (node (ref U4) (pin 10))  # CLK
      (node (ref U5) (pin 10))  # CLK (Bus)
    )
    
    (net (code 9) (name "BTN_LOAD")
      (node (ref U1) (pin D5))
      (node (ref U4) (pin 9))   # P/S
      (node (ref U5) (pin 9))   # P/S (Bus)
    )
    
    # ==================== CD4021 Cascade ====================
    (net (code 10) (name "BTN_CASCADE")
      (node (ref U5) (pin 3))   # Q8 von #1
      (node (ref U4) (pin 11))  # SER von #0
    )
    
    # ==================== 74HC595 #0 Outputs → LEDs 0-7 ====================
    (net (code 11) (name "LED0_OUT")
      (node (ref U2) (pin 15))  # QA
      (node (ref R1) (pin 1))
    )
    (net (code 12) (name "LED0_ANODE")
      (node (ref R1) (pin 2))
      (node (ref D1) (pin A))
    )
    
    (net (code 13) (name "LED1_OUT")
      (node (ref U2) (pin 1))   # QB
      (node (ref R2) (pin 1))
    )
    (net (code 14) (name "LED1_ANODE")
      (node (ref R2) (pin 2))
      (node (ref D2) (pin A))
    )
    
    (net (code 15) (name "LED2_OUT")
      (node (ref U2) (pin 2))   # QC
      (node (ref R3) (pin 1))
    )
    (net (code 16) (name "LED2_ANODE")
      (node (ref R3) (pin 2))
      (node (ref D3) (pin A))
    )
    
    (net (code 17) (name "LED3_OUT")
      (node (ref U2) (pin 3))   # QD
      (node (ref R4) (pin 1))
    )
    (net (code 18) (name "LED3_ANODE")
      (node (ref R4) (pin 2))
      (node (ref D4) (pin A))
    )
    
    (net (code 19) (name "LED4_OUT")
      (node (ref U2) (pin 4))   # QE
      (node (ref R5) (pin 1))
    )
    (net (code 20) (name "LED4_ANODE")
      (node (ref R5) (pin 2))
      (node (ref D5) (pin A))
    )
    
    (net (code 21) (name "LED5_OUT")
      (node (ref U2) (pin 5))   # QF
      (node (ref R6) (pin 1))
    )
    (net (code 22) (name "LED5_ANODE")
      (node (ref R6) (pin 2))
      (node (ref D6) (pin A))
    )
    
    (net (code 23) (name "LED6_OUT")
      (node (ref U2) (pin 6))   # QG
      (node (ref R7) (pin 1))
    )
    (net (code 24) (name "LED6_ANODE")
      (node (ref R7) (pin 2))
      (node (ref D7) (pin A))
    )
    
    (net (code 25) (name "LED7_OUT")
      (node (ref U2) (pin 7))   # QH
      (node (ref R8) (pin 1))
    )
    (net (code 26) (name "LED7_ANODE")
      (node (ref R8) (pin 2))
      (node (ref D8) (pin A))
    )
    
    # ==================== 74HC595 #1 Outputs → LEDs 8-9 ====================
    (net (code 27) (name "LED8_OUT")
      (node (ref U3) (pin 15))  # QA
      (node (ref R9) (pin 1))
    )
    (net (code 28) (name "LED8_ANODE")
      (node (ref R9) (pin 2))
      (node (ref D9) (pin A))
    )
    
    (net (code 29) (name "LED9_OUT")
      (node (ref U3) (pin 1))   # QB
      (node (ref R10) (pin 1))
    )
    (net (code 30) (name "LED9_ANODE")
      (node (ref R10) (pin 2))
      (node (ref D10) (pin A))
    )
    
    # ==================== CD4021 #0 Inputs ← Buttons 0-7 ====================
    (net (code 31) (name "BTN0_IN")
      (node (ref U4) (pin 1))   # P1
      (node (ref R11) (pin 2))
      (node (ref SW1) (pin 1))
    )
    
    (net (code 32) (name "BTN1_IN")
      (node (ref U4) (pin 13))  # P2
      (node (ref R12) (pin 2))
      (node (ref SW2) (pin 1))
    )
    
    (net (code 33) (name "BTN2_IN")
      (node (ref U4) (pin 14))  # P3
      (node (ref R13) (pin 2))
      (node (ref SW3) (pin 1))
    )
    
    (net (code 34) (name "BTN3_IN")
      (node (ref U4) (pin 4))   # P4
      (node (ref R14) (pin 2))
      (node (ref SW4) (pin 1))
    )
    
    (net (code 35) (name "BTN4_IN")
      (node (ref U4) (pin 5))   # P5
      (node (ref R15) (pin 2))
      (node (ref SW5) (pin 1))
    )
    
    (net (code 36) (name "BTN5_IN")
      (node (ref U4) (pin 6))   # P6
      (node (ref R16) (pin 2))
      (node (ref SW6) (pin 1))
    )
    
    (net (code 37) (name "BTN6_IN")
      (node (ref U4) (pin 7))   # P7
      (node (ref R17) (pin 2))
      (node (ref SW7) (pin 1))
    )
    
    (net (code 38) (name "BTN7_IN")
      (node (ref U4) (pin 15))  # P8
      (node (ref R18) (pin 2))
      (node (ref SW8) (pin 1))
    )
    
    # ==================== CD4021 #1 Inputs ← Buttons 8-9 ====================
    (net (code 39) (name "BTN8_IN")
      (node (ref U5) (pin 1))   # P1
      (node (ref R19) (pin 2))
      (node (ref SW9) (pin 1))
    )
    
    (net (code 40) (name "BTN9_IN")
      (node (ref U5) (pin 13))  # P2
      (node (ref R20) (pin 2))
      (node (ref SW10) (pin 1))
    )
  )
)
